<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background follows light/dark from the first frame, so there is no light-to-dark flash at launch. -->
    <style name="Theme.Asides" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Asides.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1600</item>
        <item name="postSplashScreenTheme">@style/Theme.Asides</item>
    </style>
</resources>
